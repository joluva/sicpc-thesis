# Copiar este archivo como .env y completar con valores reales.
# NUNCA commitear el archivo .env con valores reales.

# --- Cuenta de correo (IMAP con contraseña de aplicación) ---
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=tu_correo@gmail.com
IMAP_APP_PASSWORD=

# --- Base de datos ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sicpc
POSTGRES_USER=sicpc_user
POSTGRES_PASSWORD=

# --- API del modelo ---
MODEL_API_HOST=localhost
MODEL_API_PORT=8000

# --- Agente IA (LLM para casos de baja confianza) ---
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_ENCRYPTION_KEY=
